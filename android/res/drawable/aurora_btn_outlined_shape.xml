<?xml version="1.0" encoding="utf-8"?>
<!-- Focused: 6dp ring in theme focus color drawn inside the control (clip-safe). Default: filled shape. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent"/>
                    <corners android:radius="38dp"/>
                    <stroke android:width="6dp" android:color="?attr/auroraColorFocusRing"/>
                </shape>
            </item>
            <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
                <shape android:shape="rectangle">
        <solid android:color="@color/aurora_btn_outlined_container"/>
                <corners android:radius="38dp"/>
                <stroke android:width="2dp" android:color="@color/aurora_btn_outlined_stroke"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
        <solid android:color="@color/aurora_btn_outlined_container"/>
            <corners android:radius="38dp"/>
            <stroke android:width="2dp" android:color="@color/aurora_btn_outlined_stroke"/>
        </shape>
    </item>
</selector>
