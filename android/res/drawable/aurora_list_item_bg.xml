<?xml version="1.0" encoding="utf-8"?>
<!-- Row background: ripple (hover/press/focus layers) over selected tint; focus = inset 6dp ring; bottom divider uses outlineVariant -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/aurora_list_layer">
    <item>
        <selector>
            <item android:state_focused="true">
                <layer-list>
                    <item><shape><solid android:color="@color/aurora_list_selected"/><stroke android:width="6dp" android:color="?attr/auroraColorFocusRing"/></shape></item>
                </layer-list>
            </item>
            <item><shape><solid android:color="@color/aurora_list_selected"/></shape></item>
        </selector>
    </item>
    <item android:gravity="bottom">
        <shape><size android:height="1dp"/><solid android:color="?attr/colorOutlineVariant"/></shape>
    </item>
</ripple>
