<?xml version="1.0" encoding="utf-8"?>
<!-- Wrap the switch: focused = 6dp ring in the theme focus color -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="38dp"/>
            <stroke android:width="6dp" android:color="?attr/auroraColorFocusRing"/>
        </shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="@android:color/transparent"/></shape></item>
</selector>
