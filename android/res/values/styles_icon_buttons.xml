<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 76 x 76dp, glyph 40dp, circular. Variants: standard, filled, tonal, outlined, toggle (checkable) -->
    <style name="Widget.Aurora.IconButton.Standard" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">76dp</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="iconSize">40dp</item>
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:background">@drawable/aurora_iconbtn_standard_background</item>
        <item name="backgroundTint">@null</item>
        <item name="iconTint">@color/aurora_iconbtn_standard_content</item>
    </style>
