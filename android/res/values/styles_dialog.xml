<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeOverlay.Ivi.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">?attr/colorSurfaceContainerHigh</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Ivi.ExtraLarge</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Ivi.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Ivi.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Ivi.Button.Filled</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Ivi.Button.Text</item>
        <item name="android:windowMinWidthMajor">640dp</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>
    <style name="MaterialAlertDialog.Ivi.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Ivi.HeadlineMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="MaterialAlertDialog.Ivi.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.Ivi.BodyLarge</item>
        <item name="android:textColor">@color/dialog_body</item>
    </style>
</resources>
