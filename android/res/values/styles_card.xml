<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Ivi.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Ivi.Large</item>
        <item name="rippleColor">?attr/colorOnSurface</item>
        <item name="cardElevation">0dp</item>
        <item name="android:minHeight">120dp</item>
    </style>
    <style name="Widget.Ivi.Card.Filled"><item name="cardBackgroundColor">@color/card_container_filled</item></style>
    <style name="Widget.Ivi.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Ivi.Large</item>
    </style>
    <style name="Widget.Ivi.Card.Emphasis"><item name="cardBackgroundColor">@color/card_container_emphasis</item></style>
</resources>
