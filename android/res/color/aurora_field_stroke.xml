<?xml version="1.0" encoding="utf-8"?>
<!-- outline: focused = primary, default = outline (theme-hued), disabled 12% -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="?attr/colorOnSurface" android:alpha="0.12"/>
    <item android:state_focused="true" android:color="?attr/colorPrimary"/>
    <item android:color="?attr/colorOutline"/>
</selector>
