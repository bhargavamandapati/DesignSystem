<?xml version="1.0" encoding="utf-8"?>
<!-- Checkbox: checked = primary, unchecked = outline (theme-hued), disabled 38% -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="?attr/colorOnSurface" android:alpha="0.38"/>
    <item android:state_checked="true" android:color="?attr/colorPrimary"/>
    <item android:color="?attr/colorOutline"/>
</selector>
